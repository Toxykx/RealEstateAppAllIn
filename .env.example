# Supabase Postgres connection strings. Project Settings -> Database -> Connection string.
# DATABASE_URL: the "Transaction" pooler (port 6543, ?pgbouncer=true) — what the app
# uses at runtime. Handles many short-lived serverless connections (Vercel functions)
# without exhausting the underlying Postgres connection limit.
# DIRECT_URL: the "Session" pooler or direct connection (port 5432) — what `prisma
# migrate` uses. Transaction-mode pooling doesn't support the advisory locks and
# prepared statements migrations rely on, so this must stay a direct/session connection.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project API settings. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# NextAuth
# Generate with: npx auth secret
AUTH_SECRET="[random-32-byte-secret]"
NEXTAUTH_URL="http://localhost:3000"

# Web Push (VAPID). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose (it's sent to every browser); the private
# key is a real secret and must never be committed or shared.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="[vapid-public-key]"
VAPID_PRIVATE_KEY="[vapid-private-key]"
VAPID_SUBJECT="mailto:you@example.com"
