// Real Estate Management Platform — Prisma schema
// See technical plan for the full rationale behind each design decision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct/session connection — the transaction pooler
  // DATABASE_URL uses at runtime doesn't support the advisory locks and
  // prepared statements Prisma Migrate relies on.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  AGENT
  MANAGER
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  COMMERCIAL
}

enum ListingStatus {
  DRAFT
  AVAILABLE
  IN_PROGRESS
  SOLD
  RENTED
  ARCHIVED
}

enum DealStage {
  CONTRACT_SIGNED
  PHOTOS_COMPLETED
  PUBLISHED
  VISITS
  NEGOTIATION
  SOLD
}

enum PropertySource {
  MANUAL
  MONDAY
  GOOGLE_SHEETS
}

enum DocumentType {
  CONTRACT
  ID
  OTHER
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ContactStatus {
  NEW
  CONTACTED
  CLOSED
}

enum NotificationType {
  STAGE_CHANGE
  NEW_UPDATE
  NEW_DOCUMENT
  VISIT_SCHEDULED
  PROPERTY_ASSIGNED
  PROPERTY_PUBLISHED
  PROPERTY_CREATED
  KEY_CHECKED_OUT
  KEY_RETURNED
  PRICE_CHANGED
}

enum DealType {
  SALE
  RENT
}

enum KeyStatus {
  IN_OFFICE
  WITH_AGENT
  LOST
  DUPLICATED
}

enum ActivityType {
  PROPERTY_CREATED
  PROPERTY_EDITED
  PRICE_CHANGED
  PROPERTY_PUBLISHED
  STATUS_CHANGED
  STAGE_CHANGED
  AGENT_ASSIGNED
  CLIENT_ASSIGNED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  VISIT_CANCELLED
  PROPERTY_VIEWED
  TIMELINE_UPDATE_ADDED
  DOCUMENT_UPLOADED
  KEY_CHECKED_OUT
  KEY_RETURNED
  MEETING_LOGGED
  CALL_LOGGED
  DEAL_CLOSED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  phone         String?
  avatarUrl     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Self-relation: the Agent responsible for a Client user (only meaningful when role = CLIENT)
  managingAgentId String?
  managingAgent   User?   @relation("AgentClients", fields: [managingAgentId], references: [id], onDelete: SetNull)
  managedClients  User[]  @relation("AgentClients")

  ownedProperties    Property[]         @relation("OwnerClient")
  agentProperties    Property[]         @relation("ResponsibleAgent")
  uploadedDocuments  PropertyDocument[]
  authoredUpdates    PropertyUpdate[]
  visitsAsClient     Visit[]            @relation("ClientVisits")
  createdVisits      Visit[]            @relation("AgentCreatedVisits")
  favorites          Favorite[]
  assignedInquiries  ContactMessage[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  keysHeld           Property[]         @relation("KeyHolder")
  activityLogsAsAgent  ActivityLog[]    @relation("AgentActivity")
  activityLogsAsClient ActivityLog[]    @relation("ClientActivity")

  @@index([role])
}

model Property {
  id            String         @id @default(cuid())
  title         String
  addressLine   String
  city          String
  description   String
  price         Decimal
  currency      String         @default("ILS")
  propertyType  PropertyType
  bedrooms      Int?
  bathrooms     Int?
  areaSqm       Float?
  lat           Float?
  lng           Float?
  slug          String         @unique

  listingStatus ListingStatus  @default(DRAFT)
  dealStage     DealStage      @default(CONTRACT_SIGNED)
  dealType      DealType       @default(SALE)

  keyStatus         KeyStatus @default(IN_OFFICE)
  keyHolderId       String?
  keyHolder         User?     @relation("KeyHolder", fields: [keyHolderId], references: [id], onDelete: SetNull)
  keyLastTakenAt    DateTime?
  keyLastReturnedAt DateTime?

  source        PropertySource @default(MANUAL)
  externalId    String?

  ownerClientId String?
  ownerClient   User?          @relation("OwnerClient", fields: [ownerClientId], references: [id], onDelete: SetNull)

  agentId       String
  agent         User           @relation("ResponsibleAgent", fields: [agentId], references: [id])

  images        PropertyImage[]
  documents     PropertyDocument[]
  updates       PropertyUpdate[]
  visits        Visit[]
  favorites     Favorite[]
  contactMessages ContactMessage[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([source, externalId])
  @@index([city])
  @@index([propertyType])
  @@index([listingStatus])
  @@index([price])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyDocument {
  id              String       @id @default(cuid())
  propertyId      String
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  fileUrl         String
  storageKey      String
  docType         DocumentType @default(OTHER)
  visibleToClient Boolean      @default(false)
  uploadedById    String
  uploadedBy      User         @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime     @default(now())

  @@index([propertyId])
}

model PropertyUpdate {
  id             String     @id @default(cuid())
  propertyId     String
  property       Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  message        String
  isInternal     Boolean    @default(false)
  stageChangedTo DealStage?
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  createdAt      DateTime   @default(now())

  @@index([propertyId])
}

model Visit {
  id           String      @id @default(cuid())
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId     String?
  client       User?       @relation("ClientVisits", fields: [clientId], references: [id], onDelete: SetNull)
  visitorName  String?
  visitorPhone String?
  visitorEmail String?

  scheduledAt  DateTime
  status       VisitStatus @default(SCHEDULED)
  notes        String?

  createdById  String
  createdBy    User        @relation("AgentCreatedVisits", fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([propertyId])
  @@index([clientId])
}

model Favorite {
  id         String   @id @default(cuid())
  clientId   String
  client     User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([clientId, propertyId])
}

model ContactMessage {
  id             String        @id @default(cuid())
  name           String
  email          String
  phone          String?
  message        String
  propertyId     String?
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status         ContactStatus @default(NEW)
  assignedAgentId String?
  assignedAgent  User?         @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  propertyId String?
  property   Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
}

// A browser/device's Web Push subscription. One user can hold several (one
// per installed device), so notifications reach every device they've
// enabled it on.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id           String       @id @default(cuid())
  activityType ActivityType
  description  String

  propertyId   String?
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  agentId      String?
  agent        User?        @relation("AgentActivity", fields: [agentId], references: [id], onDelete: SetNull)

  clientId     String?
  client       User?        @relation("ClientActivity", fields: [clientId], references: [id], onDelete: SetNull)

  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([propertyId])
  @@index([agentId])
  @@index([activityType])
  @@index([createdAt])
}
