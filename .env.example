# Supabase Postgres connection string.
# Project Settings -> Database -> Connection string -> use the direct connection (port 5432) for
# this MVP so both `prisma migrate` and the app share one URL. If you later deploy to a serverless
# platform (Vercel functions) and hit connection-limit issues, switch to the "Transaction" pooler
# (port 6543, add ?pgbouncer=true) for runtime queries and keep a direct URL just for migrations.
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase project API settings. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# NextAuth
# Generate with: npx auth secret
AUTH_SECRET="[random-32-byte-secret]"
NEXTAUTH_URL="http://localhost:3000"
